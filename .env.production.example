# Copy to .env.production and fill values for your production environment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?schema=public"
JWT_SECRET=replace_with_strong_random_value
NODE_ENV=production
ERROR_TRACKING_WEBHOOK_URL=

# Auth rate limits
AUTH_SIGNUP_RATE_LIMIT=10
AUTH_SIGNUP_RATE_WINDOW_MS=60000
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_MS=60000
AUTH_VERIFY_EMAIL_RATE_LIMIT=20
AUTH_VERIFY_EMAIL_RATE_WINDOW_MS=60000
AUTH_RESEND_VERIFICATION_IP_RATE_LIMIT=10
AUTH_RESEND_VERIFICATION_IP_RATE_WINDOW_MS=60000
AUTH_RESEND_VERIFICATION_EMAIL_RATE_LIMIT=5
AUTH_RESEND_VERIFICATION_EMAIL_RATE_WINDOW_MS=600000
AUTH_REQUEST_PASSWORD_RESET_IP_RATE_LIMIT=10
AUTH_REQUEST_PASSWORD_RESET_IP_RATE_WINDOW_MS=60000
AUTH_REQUEST_PASSWORD_RESET_EMAIL_RATE_LIMIT=5
AUTH_REQUEST_PASSWORD_RESET_EMAIL_RATE_WINDOW_MS=600000
AUTH_RESET_PASSWORD_RATE_LIMIT=15
AUTH_RESET_PASSWORD_RATE_WINDOW_MS=60000

# Monitoring alert thresholds (PH1-OPS-04)
ALERT_API_P95_MS=1000
ALERT_PAGE_LOAD_MS=3000
ALERT_ERROR_RATE_PERCENT=5
ALERT_HEALTH_FAILURES=3
